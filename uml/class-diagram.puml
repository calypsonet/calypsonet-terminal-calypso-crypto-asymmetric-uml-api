package "calypso.crypto.asymmetric" as api {
    package "transaction" as transaction {
        package spi {
            interface AsymmetricCryptoCardTransactionManagerFactorySpi <<red>> {
                +createCardTransactionManager() → AsymmetricCryptoCardTransactionManagerSpi
            }
            interface AsymmetricCryptoCardTransactionManagerSpi <<red>> {
                +initTerminalPkiSession(cardPublicKey: <color:blue>ByteArray</color>) → Unit
                {method} <size:10><color:#7F8C8D>    ⚠ errors: AsymmetricCrypto</color></size>
                +updateTerminalPkiSession(cardApdu: ByteArray) → Unit
                {method} <size:10><color:#7F8C8D>    ⚠ errors: AsymmetricCrypto</color></size>
                +isCardPkiSessionValid(cardSessionSignature: ByteArray) → Boolean
                {method} <size:10><color:#7F8C8D>    ⚠ errors: AsymmetricCrypto</color></size>
            }
        }
    }
    exception "AsymmetricCrypto" as AsymmetricCrypto <<error>> <<green>> {
        +val message: String
        +val cause: Any?
    }
    class "AsymmetricCryptoApiProperties" as ApiProperties <<constants>> <<green>> {
        +const VERSION: String = "0.2"
    }
    package "certificate" as certificate {
        package spi {
            together {
            interface PcaCertificateSpi <<red>> {
                +checkCertificateAndGetContent() → <color:blue>CaCertificateContent</color>
                {method} <size:10><color:#7F8C8D>    ⚠ errors: CertificateValidation, AsymmetricCrypto</color></size>
            }
            interface CaCertificateParserSpi <<red>> {
                +getCertificateType() → Byte

                +parseCertificate(cardOutputData: ByteArray) → CaCertificateSpi
                {method} <size:10><color:#7F8C8D>    ⚠ errors: CertificateValidation</color></size>
            }
            interface CaCertificateSpi <<red>> {
                +getIssuerPublicKeyReference() → ByteArray

                +checkCertificateAndGetContent(issuerCertificateContent: <color:blue>CaCertificateContent</color>) → <color:blue>CaCertificateContent</color>
                {method} <size:10><color:#7F8C8D>    ⚠ errors: CertificateValidation, AsymmetricCrypto</color></size>
            }
            interface CardCertificateParserSpi <<red>> {
                +getCertificateType() → Byte

                +parseCertificate(cardOutputData: ByteArray) → CardCertificateSpi
                {method} <size:10><color:#7F8C8D>    ⚠ errors: CertificateValidation</color></size>
            }
            interface CardCertificateSpi <<red>> {
                +getIssuerPublicKeyReference() → ByteArray
                +getCardAid() → ByteArray
                +getCardSerialNumber() → ByteArray

                +checkCertificateAndGetPublicKey(issuerCertificateContent: <color:blue>CaCertificateContent</color>) → <color:blue>ByteArray</color>
                {method} <size:10><color:#7F8C8D>    ⚠ errors: CertificateValidation, AsymmetricCrypto</color></size>
            }
            }
            class "<color:blue>CaCertificateContent" as CaCertificateContent <<data>> <<green>> {
                +val publicKey: <back:yellow>PublicKey</back>
                +val publicKeyReference: ByteArray

                +val startDate: Long
                +val endDate: Long

                +val isAidTruncated: Boolean
                +val aid: ByteArray?

                +val isCaCertificatesAuthenticationAllowed: Boolean
                +val isCardCertificatesAuthenticationAllowed: Boolean
            }
        }
        exception "CertificateValidation" as CertificateValidation <<error>> <<green>> {
            +val message: String
            +val cause: Any?
        }
    }
}

' Associations

AsymmetricCryptoCardTransactionManagerFactorySpi ..> AsymmetricCryptoCardTransactionManagerSpi #C_LINK : provide >

CaCertificateParserSpi .right.> CaCertificateSpi #C_LINK : provide >
CardCertificateParserSpi .right.> CardCertificateSpi #C_LINK : provide >

PcaCertificateSpi ..> CaCertificateContent #C_LINK : provide >

CaCertificateSpi .right.> CaCertificateContent #C_USE : use >
CaCertificateSpi .right.> CaCertificateContent #C_LINK : provide >

CardCertificateSpi .up.> CaCertificateContent #C_USE : use >

' == LAYOUT ==

PcaCertificateSpi -[hidden]- CaCertificateSpi
CaCertificateParserSpi -[hidden]- CardCertificateParserSpi
CardCertificateSpi -[hidden]- CertificateValidation
AsymmetricCryptoCardTransactionManagerSpi -[hidden]- AsymmetricCrypto
AsymmetricCrypto -[hidden]- ApiProperties

